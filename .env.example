# Jarvis Lite v0.3 — environment configuration example
# Copy to .env and fill in values. Never commit .env to git.

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed Telegram user IDs (integers)
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Comma-separated whitelist of Docker container names that can be managed
SAFE_CONTAINERS=api,bot,nginx,postgres

# Subprocess timeout in seconds for docker/system commands
COMMAND_TIMEOUT=20

# Default number of log lines to fetch
DEFAULT_LOG_LINES=80

# Maximum number of log lines a user can request
MAX_LOG_LINES=500

# Log analysis provider: local | openai | anthropic
# "local" uses rule-based analysis and requires no API key
AI_PROVIDER=local

# OpenAI settings (used only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic settings (used only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
